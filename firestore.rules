rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de Segurança
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let role = getUserData().role;
      return role in ['lider', 'leader', 'discipulador', 'root'];
    }

    function isRoot() {
      return getUserData().role == 'root';
    }

    // Coleção 'counters': Gerenciamento de IDs sequenciais
    match /counters/{counterId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // Coleção 'users': Perfis e RBAC
    match /users/{userId} {
      // Dono do perfil pode ler e editar seus próprios dados básicos
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Admins podem listar e criar usuários
      allow read, create: if isAuthenticated() && isAdmin();
      
      // Regras granulares de atualização para Admins
      allow update: if isAuthenticated() && (
        isRoot() ||
        (getUserData().role == 'discipulador' && resource.data.networkId == getUserData().networkId) ||
        ((getUserData().role == 'lider' || getUserData().role == 'leader') && resource.data.cellId == getUserData().cellId)
      );
    }

    // Coleções Estruturais e Operacionais (Acessadas prioritariamente via API)
    match /networks/{networkId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    match /cells/{cellId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
  }
}
