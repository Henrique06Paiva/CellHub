rules_version = '2';

// Craft rules based on role (Membro, Lider, Discipulador)
service firebase.storage {
  match /b/{bucket}/o {

    // Regra geral: apenas leitura para autenticados, escrita bloqueada por padrão
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Bloqueado — regras específicas abaixo controlam escrita
    }

    // Logos de células, redes, perfis (uploads via front-end)
    match /logos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Eventos: banners e galeria com validação de tamanho/tipo
    match /events/{eventId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
